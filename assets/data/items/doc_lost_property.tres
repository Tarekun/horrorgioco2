category = 4
description = "Housekeeping's ledger of things guests left behind."
pages = PackedStringArray("LOST PROPERTY\n\nRoom 22. One sandal, left.\nRoom 22. Sunglasses, tortoiseshell.\nRoom 22. Hair clip.\nRoom 22. Paperback, a page folded down.", "Room 22. Men's watch.\nGuest says keep it.")
